# Guide

guide: {
  metrics: count: entity: 5
  metrics: count: path: 6
  metrics: count: method: 6

  entity: embed_content: {
    path: "/models/{model}:embedContent": {
      op: create: method: *POST
    }
  }

  entity: generate_content: {
    path: "/models/{model}:generateContent": {
      op: create: method: *POST
    }
    path: "/models/{model}:streamGenerateContent": {
      op: create: method: *POST
    }
  }

  entity: interaction: {
    path: "/interactions": {
      op: create: method: *POST
    }
  }

  entity: list_model: {
  }

  entity: model: {
    path: "/models": {
      op: list: method: *GET
    }
    path: "/models/{model}": {
      rename: param: "model": *"id"
      op: load: method: *GET
    }
  }

}