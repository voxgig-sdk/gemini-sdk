# Entity: model

main: kit: entity: model: {

  alias: field: {}

  fields: [
    {
      name: "description"
      req: false
      short: "Model description"
      type: "`$STRING`"
    }
    {
      name: "displayName"
      req: false
      short: "Human-readable model name"
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      type: "`$STRING`"
    }
    {
      name: "inputTokenLimit"
      req: false
      short: "Maximum input tokens"
      type: "`$INTEGER`"
    }
    {
      name: "name"
      req: false
      short: "Model resource name"
      type: "`$STRING`"
    }
    {
      name: "outputTokenLimit"
      req: false
      short: "Maximum output tokens"
      type: "`$INTEGER`"
    }
    {
      name: "supportedGenerationMethods"
      req: false
      short: "Supported generation methods"
      type: "`$ARRAY`"
    }
    {
      name: "version"
      req: false
      short: "Model version"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "model"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                kind: "query"
                name: "key"
                orig: "key"
                reqd: true
                type: "`$STRING`"
              }
              {
                example: 50
                kind: "query"
                name: "page_size"
                orig: "page_size"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                kind: "query"
                name: "page_token"
                orig: "page_token"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/models"
          segments: [
            {
              lit: "models"
            }
          ]
          select: {
            exist: [
              "key"
              "page_size"
              "page_token"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.models`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                example: "gemini-3.6-flash"
                kind: "param"
                name: "id"
                orig: "model"
                reqd: true
                type: "`$STRING`"
              }
            ]
            query: [
              {
                kind: "query"
                name: "key"
                orig: "key"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/models/{model}"
          rename: {
            param: {
              model: "id"
            }
          }
          segments: [
            {
              lit: "models"
            }
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "id"
              "key"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
