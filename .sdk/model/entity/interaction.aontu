# Entity: interaction

main: kit: entity: interaction: {

  alias: field: {}

  fields: [
    {
      name: "config"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "input"
      req: true
      type: "`$STRING`"
    }
    {
      name: "model"
      req: true
      type: "`$STRING`"
    }
  ]

  name: "interaction"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/interactions"
          parts: [
            "interactions"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.metadata`"
          }
        }
      ]
    }
  }



}
