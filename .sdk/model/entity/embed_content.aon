# Entity: embed_content

main: kit: entity: embed_content: {

  alias: field: {}

  fields: [
    {
      name: "content"
      req: true
      type: "`$OBJECT`"
    }
    {
      name: "taskType"
      req: false
      short: "Optional task type for embedding optimization"
      type: "`$STRING`"
    }
    {
      name: "title"
      req: false
      short: "Optional title for document embeddings"
      type: "`$STRING`"
    }
    {
      name: "values"
      req: false
      short: "Embedding vector values"
      type: "`$ARRAY`"
    }
  ]

  name: "embed_content"
  op: {
    create: {
      name: "create"
      points: [
        {
          args: {
            params: [
              {
                example: "embedding-001"
                kind: "param"
                name: "model"
                orig: "model"
                reqd: true
                type: "`$STRING`"
              }
            ]
            query: [
              {
                kind: "query"
                name: "key"
                orig: "key"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "POST"
          orig: "/models/{model}:embedContent"
          segments: [
            {
              lit: "models"
            }
            {
              lit: "{model}:embedContent"
            }
          ]
          select: {
            exist: [
              "key"
              "model"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.embedding`"
          }
        }
      ]
    }
  }



}
